# Frontend Environment Configuration
# 
# Default: ใช้ dynamic hostname + port 18000 อัตโนมัติ
#   - เปิดจากเครื่องไหนก็เรียก gateway เครื่องนั้น
#   - ไม่ต้องตั้งค่า .env สำหรับแต่ละเครื่อง
#
# Override: ตั้งค่าด้านล่างนี้ถ้าต้องการใช้ URL เฉพาะ

# ----- API Base URL (ไม่บังคับ) -----
# ถ้าไม่ตั้ง จะใช้: http://<hostname ของเครื่องที่เปิด>:18000/api/SSO_login
#
# ตัวอย่าง:
# VITE_API_BASE=https://sso.example.com/api/SSO_login
# VITE_API_BASE=http://10.0.32.71:18000/api/SSO_login

# ----- Gateway Port (ไม่บังคับ) -----
# ใช้เฉพาะเมื่อไม่ตั้ง VITE_API_BASE
# Default: 18000
# VITE_GATEWAY_PORT=18000

HTTP_ADDR=:12080
FRONTEND_ORIGIN=*

# DATABASE_URL ใช้รูปแบบ connection string ของ pgx
# postgres://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=disable
DATABASE_URL=postgres://pguser:pgpass123@10.0.32.71:5432/postgres?sslmode=disable

DB_MAX_OPEN=20
DB_MAX_LIFETIME_MIN=30

# ----- JWT (admin login) -----
# Secret ใช้ HMAC-SHA256 ในการ sign token — เปลี่ยนเป็นค่า secret จริงใน production
# ต้องยาวอย่างน้อย 32 bytes แนะนำใช้ random เช่น: openssl rand -hex 32
JWT_SECRET=dev-only-change-me-please-32-bytes-min!!
JWT_TTL_MINUTES=480

# ----- External Employee API (ใช้ดึงชื่อ-นามสกุล จาก ADUser) -----
# URL base เช่น http://10.0.32.202:3030/api_local
# Backend จะเรียก: {base}/_survey_employee.php?Action=GetEmployeeData&emp_id=<ADUser>&token=base64(ADUser)
EMPLOYEE_API_URL=http://10.0.32.202:3030/api_local
EMPLOYEE_API_TIMEOUT_SEC=5
# cache TTL (นาที) — ลดการยิง external API บ่อย
EMPLOYEE_API_CACHE_MIN=60
